  "capabilities": {
    "text": true,
    "streaming": true,
    "tools": true,
    "toolsWithStreaming": true,
    "structuredOutput": true,
    "structuredOutputWithTools": true,
    "embeddings": false,
    "thinking": false
  },
  "errorRules": [
    {
      "status": 401,
      "pattern": "Invalid API key|Authentication",
      "class": "authentication",
      "message": "Invalid Fireworks API key. Get one at https://fireworks.ai/account/api-keys"
    }
  ],
  "setup": {
    "url": "https://fireworks.ai/account/api-keys",
    "apiKeyFormat": null,
    "billingPolicy": "free-with-card",
    "instructions": [
      "1. Visit: https://fireworks.ai/account/api-keys",
      "2. Sign in to your Fireworks AI account",
      "3. Create a new API key",
      "4. Set {apiKeyEnvVar} in your .env file"
    ]
  },
  "evidence": {
    "rosterVerified": {
      "date": "2026-09-28",
      "method": "GET /models against the live account, cross-checked with a real chat call per id"
    },
    "liveMatrix": {
      "date": "2026-09-28",
      "result": "Issue #1796: check:models reported the default, kimi-k2p6, as dead. Confirmed live — GET /models still lists it, but POST /chat/completions 404s 'Model not found, inaccessible, and/or not deployed', the same still-listed-but-unservable pattern deepseek-v4-pro hit in 2026-08. Moved the default to kimi-k3, the same Moonshot family's newest generation: 200 OK on a 1-token call, and a full-length call returns a proper OpenAI-shaped tool_calls entry with finish_reason=tool_calls, confirming tool support survives the swap. kimi-k2p6 marked retired rather than deleted, per the frozen-enum rule. gpt-oss-120b, qwen3p8-max and glm-5p3 (the rest of fallbacks/topModels) were re-probed alive at the same time."
    },
    "addedInPR": "https://github.com/juspay/neurolink/pull/1587"
  }
}
